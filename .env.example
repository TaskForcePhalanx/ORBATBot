# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Discord bot token (from Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=your_discord_bot_token_here

# OPTIONAL. Google service account credentials JSON (paste the entire contents
# of your JSON key file as a single line). Only needed for sheet-backed
# operations — an operation started from an ORBAT never touches Google, and the
# bot runs perfectly well with this left empty.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Password for the Postgres container (Docker only — docker-compose builds DATABASE_URL from this)
# Not needed on Railway — DATABASE_URL is injected automatically
DB_PASSWORD=yourpassword

# Full Postgres connection string. Only set this by hand when running the bot
# outside Docker (local development) — Railway injects it, and docker-compose
# builds it from DB_PASSWORD. Uncomment and point it at your local Postgres.
# DATABASE_URL=postgresql://orbatuser:yourpassword@localhost:5432/orbatbot

# Optional: Railway API token for the /restart command (Railway dashboard > Account Settings > Tokens)
# Without it, /restart falls back to exiting the process so Railway's restart policy relaunches it
RAILWAY_API_TOKEN=

# ---------------------------------------------------------------------------
# Web UI (optional) — the browser interface for managing events.
# Leave the three below empty and the bot runs exactly as before, with no
# HTTP listener at all.
# ---------------------------------------------------------------------------

# Discord Developer Portal > OAuth2. The client ID is the application ID;
# generate a client secret there too. Add {WEB_BASE_URL}/auth/callback as a
# redirect URI on the same page, or the login will be rejected.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Secret used to sign the session cookies. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
WEB_SECRET_KEY=

# Public URL of the site, without a trailing slash, e.g. https://orbat.example.com
# Every URL here needs {that URL}/auth/callback registered in the Developer
# Portal, or the login on that name is rejected.
#
# Several names, separated by spaces or commas, are allowed — the site then
# answers on each of them and keeps whoever is looking at one on that one:
#   WEB_BASE_URL=https://orbat.example.com https://bot.example.org
#
# ORDER MATTERS. The first is the canonical name, and every link that leaves
# the site carries it: a map's share link, and the link the bot posts into a
# Discord channel. Browsing on the second name still hands out links to the
# first, which is the point — a link is copied to somebody who was never here.
# Put the name you want people to see first.
WEB_BASE_URL=

# Optional: where to listen. Railway injects PORT; set WEB_PORT only for local runs.
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Optional: set to 0 to keep the site off even when everything above is filled in
# WEB_ENABLED=1

# Optional: announce joins and leaves (cogs/memberlog.py). Requires the privileged
# "Server Members Intent" — tick it in the Developer Portal FIRST, then set this to 1.
# Setting it while the intent is not granted stops the bot from starting at all.
# Bans and unbans are logged without it.
# MEMBER_EVENTS=0

# Optional: the name shown in the header, the browser tab and the footer.
# For the logo, commit an image to web/static/logo.png — it is picked up on start.
# WEB_BRAND=TFP BOT

# Optional: how the bot identifies itself to Reddit when it reads a watched
# feed (cogs/redditfeed.py). Reddit rate-limits anonymous-looking clients hard,
# so give it something descriptive — ideally naming your own Reddit account:
#   REDDIT_USER_AGENT=orbatbot/1.0 (by /u/YourRedditName)
# Left empty, a sensible default is used. No API key or registration is needed:
# the bot reads the public RSS feed, nothing else.
# REDDIT_USER_AGENT=

# Optional: the unit's OCAP server (utils/ocap.py). The Kill Tracker reads its
# recording list and files from here — both public, no login. No trailing slash.
# OCAP_BASE_URL=https://ocap.taskforcephalanx.com

# Optional: set to 0 to stop polling the OCAP server for new recordings
# (cogs/killtracker.py). What is already counted keeps being served.
# KT_SYNC=1
